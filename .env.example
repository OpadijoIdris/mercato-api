NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
LOG_LEVEL=info

# Matches docker-compose.local.yml (`npm run docker:up`)
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5434/ecommerce

# Used by `npm test` (database is created by docker-compose.local.yml on first start)
TEST_DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5434/ecommerce_test

# Stops the Prisma CLI update check, which can hang commands on a slow network.
CHECKPOINT_DISABLE=1
