      "scope": "collection"
    },
    {
      "_id": "env_base",
      "_type": "environment",
      "parentId": "wrk_ecommerce",
      "name": "Base Environment",
      "data": {}
    },
    {
      "_id": "env_local",
      "_type": "environment",
      "parentId": "env_base",
      "name": "Local",
      "data": {
        "base_url": "http://localhost:3000",
        "user_id": "{% response 'body', 'req_users_create', 'b64::JC5kYXRhLmlk::46b', 'never', 60 %}",
        "product_id": "{% response 'body', 'req_products_create', 'b64::JC5kYXRhLmlk::46b', 'never', 60 %}"
      }
    },

    {
      "_id": "fld_system",
