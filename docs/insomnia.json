      "name": "System",
      "metaSortKey": 0
    },
    {
      "_id": "req_health",
      "_type": "request",
      "parentId": "fld_system",
      "name": "Health check",
      "method": "GET",
      "url": "{{ _.base_url }}/health",
      "headers": [],
      "parameters": [],
      "body": {},
      "metaSortKey": 0
    },

    {
      "_id": "fld_users",
      "_type": "request_group",
      "parentId": "wrk_ecommerce",
      "name": "Users",
      "metaSortKey": 1
    },
    {
      "_id": "req_users_create",
      "_type": "request",
      "parentId": "fld_users",
      "name": "Create user",
      "description": "Run this first: Get / Update / Delete user use the id it returns.",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "parameters": [],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"supersecret\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+2348012345678\"\n}"
      },
      "metaSortKey": 0
    },
    {
      "_id": "req_users_create_admin",
      "_type": "request",
      "parentId": "fld_users",
      "name": "Create admin user",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "parameters": [],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"supersecret\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Admin\",\n  \"role\": \"ADMIN\"\n}"
      },
      "metaSortKey": 1
    },
    {
      "_id": "req_users_list",
      "_type": "request",
      "parentId": "fld_users",
      "name": "List users",
      "description": "Tick `role` or `search` in the Params tab to filter.",
      "method": "GET",
      "url": "{{ _.base_url }}/users",
      "headers": [],
      "parameters": [
        { "name": "page", "value": "1" },
        { "name": "limit", "value": "20" },
        { "name": "role", "value": "ADMIN", "disabled": true },
        { "name": "search", "value": "jane", "disabled": true }
      ],
      "body": {},
      "metaSortKey": 2
    },
    {
      "_id": "req_users_get",
      "_type": "request",
      "parentId": "fld_users",
      "name": "Get user",
      "method": "GET",
      "url": "{{ _.base_url }}/users/{{ _.user_id }}",
      "headers": [],
      "parameters": [],
      "body": {},
      "metaSortKey": 3
    },
    {
      "_id": "req_users_update",
      "_type": "request",
      "parentId": "fld_users",
      "name": "Update user",
      "method": "PATCH",
      "url": "{{ _.base_url }}/users/{{ _.user_id }}",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "parameters": [],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"lastName\": \"Smith\",\n  \"phone\": \"+2348098765432\"\n}"
      },
      "metaSortKey": 4
    },
    {
      "_id": "req_users_delete",
      "_type": "request",
      "parentId": "fld_users",
      "name": "Delete user",
      "method": "DELETE",
      "url": "{{ _.base_url }}/users/{{ _.user_id }}",
      "headers": [],
      "parameters": [],
      "body": {},
      "metaSortKey": 5
    },

    {
      "_id": "fld_users_errors",
      "_type": "request_group",
      "parentId": "fld_users",
      "name": "Error cases",
      "metaSortKey": 6
