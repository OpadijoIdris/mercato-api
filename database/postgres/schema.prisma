generator client {
  provider = "prisma-client"
  output   = "../../src/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  // Stored lowercased so lookups and the unique constraint are case-insensitive.
  email     String   @unique
  // bcrypt hash. Omitted from every query by default (see database/postgres/prisma.ts).
  password  String
  firstName String
  lastName  String
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("users")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  // Stored in the smallest currency unit (kobo, cents) to avoid floating point errors.
  price       Int
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@map("products")
}
